static func sample(clip:String,phase:float,joint:int)->Vector3:
 var frames:Array=CLIPS.get(clip,CLIPS["gather"])
 var pos=fposmod(phase,TAU)/TAU*frames.size()
 var i=int(floor(pos))
 var a:Array=frames[i]
 var b:Array=frames[(i+1)%frames.size()]
 var j=joint*3
 var t=pos-floor(pos)
 return Vector3(lerpf(float(a[j]),float(b[j]),t),lerpf(float(a[j+1]),float(b[j+1]),t),lerpf(float(a[j+2]),float(b[j+2]),t))
